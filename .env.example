# Argus Backend Environment Configuration

# PostgreSQL Configuration (Locally Hosted)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=argus_db
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/argus_db

# MongoDB Configuration (Locally Hosted)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=argus_db
MONGODB_NOTIFICATIONS_COLLECTION=notifications

# Server & Security Settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=argus_secret_key_super_secure_9941a87b2
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# NLP & Machine Learning Pipeline
MODEL_DEVICE=cpu
BERT_MODEL_NAME=bert-base-uncased
BART_MODEL_NAME=facebook/bart-large-cnn
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CONFIDENCE_THRESHOLD=0.75
